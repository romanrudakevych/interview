{
  "name": "interview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-questions-data.mjs",
    "predev": "npm run build:data",
    "dev": "vite",
    "prebuild": "npm run build:data",
    "build": "vite build",
    "lint": "oxlint",
    "pretest": "npm run build:data",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:worker": "vitest run src/workers --coverage --coverage.include='src/workers/**' --coverage.exclude='**/*.test.js' --coverage.thresholds.statements=100 --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=85",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/web-worker": "^5.0.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  }
}
